{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": ".dist",

    "strict": true,
    "noImplicitAny": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
